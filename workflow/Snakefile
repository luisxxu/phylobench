import sys
from pathlib import Path

from snakemake.utils import validate

from phylobench.emp import EMP_QUERY_N
from phylobench.tables import load_arms

# Arms come only from config/arms/*.yaml (keyed by file stem); this overrides any `arms`
# key from --configfile. `--config arm=<stem>` runs one arm (CI smoke matrix).
config["arms"] = load_arms(
    Path(workflow.basedir).parent / "config" / "arms", only=config.get("arm")
)

validate(config, "../config/schema.yaml")

MEASURE = f"{sys.executable} -m phylobench.measure"
SCRIPTS = Path(workflow.basedir) / "scripts"

for smk in sorted(Path(workflow.basedir, "rules").glob("*.smk")):

    include: str(smk)


ruleorder: emp_refprep > refprep_me_tree
ruleorder: emp_refprep > refprep_epa_ng_model
ruleorder: emp_hmm > hmmbuild


rule all:
    input:
        "results/runs.tsv",
        "results/accuracy.tsv",
        "results/concordance.tsv",
        ["data/emp/MANIFEST.tsv"] if any(d in EMP_QUERY_N for d in config["datasets"]) else [],
