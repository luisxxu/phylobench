from pathlib import Path

import yaml
from snakemake.utils import validate

# Arms come only from config/arms/*.yaml (keyed by file stem); this overrides any `arms` key from --configfile.
config["arms"] = {
    p.stem: yaml.safe_load(p.read_text())
    for p in sorted((Path(workflow.basedir).parent / "config" / "arms").glob("*.yaml"))
}

validate(config, "../config/schema.yaml")

import sys

MEASURE = f"{sys.executable} -m phylobench.measure"

for smk in sorted(Path(workflow.basedir, "rules").glob("*.smk")):

    include: str(smk)


rule all:
    input:
        [],
